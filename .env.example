# ── Required ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgres://preader:preader@localhost:5432/preader
# Meta Llama API key (server-side only — never exposed to the browser).
# Create one at https://llama.developer.meta.com
LLAMA_API_KEY=
# Encrypts documents at rest (AES-256-GCM). Either a 32-byte base64 key, generated with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# or a random passphrase of at least 32 characters from a password manager.
ENCRYPTION_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# Public URL of the app; used for CSRF origin checks (defaults to request host)
APP_URL=http://localhost:3000
# Rewriting model (Meta Llama API model id). Alternatives:
#   Llama-4-Scout-17B-16E-Instruct-FP8 (faster, cheaper) · Llama-3.3-70B-Instruct
LLAMA_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8
# Maximum output tokens per batch. Truncated batches are split and retried.
LLAMA_MAX_OUTPUT_TOKENS=4096
# OpenAI-compatible endpoint of the Llama API
LLAMA_BASE_URL=https://api.llama.com/compat/v1
# Image Humanizer limits. The Llama API can't edit images, so the Image Humanizer
# is switched off in production; these apply only with AI_PROVIDER=mock.
IMAGE_DAILY_LIMIT=10
IMAGES_PER_MINUTE=3
# ── AI Content Detector ─────────────────────────────────────────────────────
# Content Credentials (C2PA), metadata and writing-pattern checks work with no setup.
# Likelihood scores need a detection model. Leave blank to run without scores.
# Text model: GPTZero (https://gptzero.me/api). Text is sent to GPTZero for analysis.
GPTZERO_API_KEY=
# Image model: Sightengine "genai" (https://sightengine.com). Images are sent to Sightengine.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
DETECT_DAILY_LIMIT=60
DETECT_PER_MINUTE=8
# Max image size in MB (always 4 on Vercel because of its request-size limit)
DETECT_MAX_IMAGE_MB=4
# Limits
MAX_WORDS_PER_REQUEST=8000
DAILY_WORD_LIMIT=50000
REWRITES_PER_MINUTE=8
# ── Email (password reset) ──────────────────────────────────────────────────
# Configure ONE provider. Without one, password reset is unavailable in production
# (in development, emails are printed to the server log instead).
# APP_URL above is required in production: reset links are built from it, never from the Host header.
EMAIL_FROM="PanPen <no-reply@your-domain.org>"
# Resend (https://resend.com):
RESEND_API_KEY=
# …or any SMTP server, e.g. smtps://user:pass@smtp.example.org:465
SMTP_URL=
# Set to "false" to close public sign-ups
ALLOW_SIGNUPS=true
# Development only: "mock" uses a local fake model (refused in production)
AI_PROVIDER=llama
