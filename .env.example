# ── Required ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgres://preader:preader@localhost:5432/preader
# OpenAI API key (server-side only — never exposed to the browser)
OPENAI_API_KEY=sk-...
# Encrypts documents at rest (AES-256-GCM). Either a 32-byte base64 key, generated with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# or a random passphrase of at least 32 characters from a password manager.
ENCRYPTION_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# Public URL of the app; used for CSRF origin checks (defaults to request host)
APP_URL=http://localhost:3000
# Rewriting model. Defaults to OpenAI's most capable general model.
OPENAI_MODEL=gpt-5.5
# Reasoning effort for reasoning models: none | minimal | low | medium | high | xhigh
OPENAI_REASONING_EFFORT=medium
# Embedding model used to measure meaning drift between original and revised text
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# Set to "false" to skip the embedding-based meaning check
MEANING_CHECK=true
# Limits
MAX_WORDS_PER_REQUEST=8000
DAILY_WORD_LIMIT=50000
REWRITES_PER_MINUTE=8
# ── Email (password reset) ──────────────────────────────────────────────────
# Configure ONE provider. Without one, password reset is unavailable in production
# (in development, emails are printed to the server log instead).
# APP_URL above is required in production: reset links are built from it, never from the Host header.
EMAIL_FROM="Preader <no-reply@your-domain.org>"
# Resend (https://resend.com):
RESEND_API_KEY=
# …or any SMTP server, e.g. smtps://user:pass@smtp.example.org:465
SMTP_URL=
# Set to "false" to close public sign-ups
ALLOW_SIGNUPS=true
# Development only: "mock" uses a local fake model (refused in production)
AI_PROVIDER=openai
