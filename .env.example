# ── Required ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgres://preader:preader@localhost:5432/preader
# OpenAI API key (server-side only — never exposed to the browser)
OPENAI_API_KEY=sk-...
# 32-byte key, base64-encoded, used to encrypt documents at rest (AES-256-GCM).
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
# Public URL of the app; used for CSRF origin checks (defaults to request host)
APP_URL=http://localhost:3000
# Rewriting model. Defaults to OpenAI's most capable general model.
OPENAI_MODEL=gpt-5.5
# Reasoning effort for reasoning models: none | minimal | low | medium | high | xhigh
OPENAI_REASONING_EFFORT=medium
# Embedding model used to measure meaning drift between original and revised text
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# Set to "false" to skip the embedding-based meaning check
MEANING_CHECK=true
# Limits
MAX_WORDS_PER_REQUEST=8000
DAILY_WORD_LIMIT=50000
REWRITES_PER_MINUTE=8
# Set to "false" to close public sign-ups
ALLOW_SIGNUPS=true
# Development only: "mock" uses a local fake model (refused in production)
AI_PROVIDER=openai
